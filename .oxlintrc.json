{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "node"],
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": ["dist/**", "demo-dist/**", "coverage/**"],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  }
}
